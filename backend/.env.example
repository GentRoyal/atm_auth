# supabase is the default. Use postgresql, postgres, or local for a local Postgres DB.
DATABASE_PROVIDER=supabase

# Supabase Postgres. Use the session pooler when possible.
SUPABASE_DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres?ssl=true
# Optional. If omitted, SUPABASE_DATABASE_URL is reused with the psycopg SQLAlchemy driver.
SUPABASE_DATABASE_URL_SYNC=

# Local or self-hosted PostgreSQL.
POSTGRES_DATABASE_URL=postgresql://postgres:password@localhost:5432/atm_auth_system
# Optional. If omitted, POSTGRES_DATABASE_URL is reused with the psycopg SQLAlchemy driver.
POSTGRES_DATABASE_URL_SYNC=

# Backward-compatible fallback used when the selected provider URL above is empty.
DATABASE_URL=postgresql://postgres:password@localhost:5432/atm_auth_system
DATABASE_URL_SYNC=
SECRET_KEY=replace-with-a-long-random-secret
SESSION_EXPIRE_MINUTES=10
BASE_URL=http://localhost:8000
# Set this to your HTTPS tunnel URL, for example https://abc123.ngrok-free.app.
# The SMS face-auth link uses this value when present.
PUBLIC_BASE_URL=
CORS_ORIGINS=http://localhost:8000

# dev logs the link to the backend console and returns it to the ATM UI.
# Use twilio or africastalking only when the matching credentials are set.
SMS_PROVIDER=dev
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
AT_USERNAME=sandbox
AT_API_KEY=

VOICE_SIMILARITY_THRESHOLD=0.65
FACE_SIMILARITY_THRESHOLD=0.55
