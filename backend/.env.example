DATABASE_URL=postgresql://postgres:password@localhost:5432/atm_auth_system
# Optional. If omitted, DATABASE_URL is reused with the psycopg SQLAlchemy driver.
DATABASE_URL_SYNC=
SECRET_KEY=replace-with-a-long-random-secret
SESSION_EXPIRE_MINUTES=10
BASE_URL=http://localhost:8000
# Set this to your HTTPS tunnel URL, for example https://abc123.ngrok-free.app.
# The SMS face-auth link uses this value when present.
PUBLIC_BASE_URL=
CORS_ORIGINS=http://localhost:8000

# dev logs the link to the backend console and returns it to the ATM UI.
# Use twilio or africastalking only when the matching credentials are set.
SMS_PROVIDER=dev
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
AT_USERNAME=sandbox
AT_API_KEY=

VOICE_SIMILARITY_THRESHOLD=0.65
FACE_SIMILARITY_THRESHOLD=0.55
