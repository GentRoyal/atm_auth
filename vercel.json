{
  "experimentalServices": {
    "app": {
      "entrypoint": "api/index.py",
      "framework": "fastapi",
      "routePrefix": "/",
      "memory": 1024,
      "maxDuration": 60,
      "includeFiles": [
        "backend/**",
        "frontend/**",
        "database/**",
        "requirements.txt"
      ],
      "excludeFiles": [
        ".venv/**",
        "outputs/**",
        "tools/**",
        "*.log",
        "*tunnel*.log"
      ]
    }
  }
}
