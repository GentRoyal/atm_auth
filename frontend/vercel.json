{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/",
      "destination": "/index.html"
    },
    {
      "source": "/atm",
      "destination": "/atm/index.html"
    },
    {
      "source": "/register",
      "destination": "/register/index.html"
    }
  ]
}
